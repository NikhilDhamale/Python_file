   "source": [
    "class laptop:\n",
    "    storage_type=\"ssd\"\n",
    "\n",
    "    def __init__(self,ram,storage):\n",
    "        self.ram=ram\n",
    "        self.storage=storage\n",
    "\n",
    "    def get_info(self):\n",
    "        print(f\"laptop has{self.ram} ram and {self.storage} storage\")\n",
    "\n",
    "l1=laptop(\"16gb\",\"512gb\")\n",
    "l2=laptop(\"8gb\",\"256gb\")\n",
    "\n",
    "l1.get_info()\n"
   ]
